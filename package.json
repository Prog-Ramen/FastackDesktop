{
  "name": "fastack",
  "productName": "Fastack",
  "version": "1.0.0",
  "description": "Context-switching menubar task manager. Stacks tasks by priority and time, encrypts them, syncs to GitHub, Dropbox, or Google Drive.",
  "author": "Samar Sajnani <samarsajnani@gmail.com>",
  "homepage": "https://github.com/ssajnani/FastackDesktop",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:integrations:live": "node test/live-backends.js",
    "start": "electron . --disable-gpu --disable-direct-composition",
    "dev": "FASTACK_DEV=1 electron . --disable-gpu --disable-direct-composition",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.samarsajnani.fastack",
    "productName": "Fastack",
    "copyright": "Copyright © 2026 Samar Sajnani",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "**/*",
      "!**/{.DS_Store,.git,.vscode,.tool-versions,demo,release,dist,screenshot.png,README.md}",
      "!**/*.map"
    ],
    "extraResources": [
      "eng.traineddata"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Office"
    }
  },
  "devDependencies": {
    "electron": "19.0.4",
    "electron-builder": "^24.13.3",
    "electron-context-menu": "^0.10.0",
    "nodemon": "^2.0.16",
    "webpack": "^4.12.2"
  },
  "dependencies": {
    "@babel/parser": "^7.29.7",
    "@electron/remote": "^2.0.8",
    "@grpc/grpc-js": "^1.6.7",
    "@toast-ui/editor": "^3.1.7",
    "@toast-ui/editor-plugin-chart": "^3.0.1",
    "@toast-ui/editor-plugin-code-syntax-highlight": "^3.0.0",
    "@toast-ui/editor-plugin-color-syntax": "^3.0.3",
    "@toast-ui/editor-plugin-dooray-auto-complete": "^0.0.2",
    "@toast-ui/editor-plugin-dooray-parser": "^0.0.3",
    "@toast-ui/editor-plugin-table-merged-cell": "^3.0.2",
    "@toast-ui/editor-plugin-uml": "^3.0.1",
    "@types/prismjs": "^1.26.0",
    "@xenova/transformers": "^2.17.2",
    "active-win": "^8.2.1",
    "async": "^3.2.4",
    "base-64": "^1.0.0",
    "bootstrap": "^5.1.3",
    "crypto-js": "^4.1.1",
    "dropbox": "^10.32.0",
    "electron-is-accelerator": "^0.2.0",
    "electron-screencapture": "^1.1.0",
    "github-api": "^3.4.0",
    "hotkeys-js": "^3.9.4",
    "jquery": "^3.6.0",
    "local-storage": "^2.0.0",
    "pbkdf2": "^3.1.2",
    "pkce-challenge": "^3.0.0",
    "plantuml-encoder": "^1.4.0",
    "randombytes": "^2.1.0",
    "screenshot-desktop": "^1.12.7",
    "temp": "^0.9.4",
    "tesseract.js": "^2.1.5",
    "undici": "^6.13.0"
  }
}
